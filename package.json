{
  "name": "server-monitor",
  "version": "2.0.0",
  "description": "Online Server Monitor Website",
  "productName": "Server Monitor",
  "author": "dzxrly2 <dzxrly2@gmail.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "quasar prepare --silent",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "dev": "quasar dev",
    "build": "quasar build"
  },
  "dependencies": {
    "@quasar/extras": "2.0.3",
    "axios": "1.19.0",
    "pinia": "4.0.3",
    "quasar": "2.24.0",
    "vue": "3.5.41",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@quasar/app-vite": "3.5.0",
    "@types/node": "26.2.0",
    "@vue/test-utils": "2.4.11",
    "autoprefixer": "10.5.4",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
